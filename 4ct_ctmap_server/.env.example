# ================================================================
# 4ct_ctmap_server 环境变量示例
# 复制本文件为 .env 并按需填写（.env 已被 .gitignore 忽略，勿提交真实密钥）。
# 服务已在 src/index.ts 顶部 `import 'dotenv/config'`，启动时会自动加载 .env。
# ================================================================

# 服务监听端口（默认 3001，前端 vite 代理已指向它）
PORT=3001

# 编辑页写接口鉴权 —— 共享管理员密钥
# 请求头 X-Admin-Key 必须等于此值；未配置时写接口不鉴权且启动会打印警告。
# 生产/公网部署务必设置，且使用足够长的随机串。
CTMAP_ADMIN_KEY=123456